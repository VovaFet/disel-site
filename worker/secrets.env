# Names of the Worker's runtime secrets (worker/index.ts), uploaded with every version by the Cloudflare deploy
# commands (wrangler deploy / wrangler preview --secrets-file worker/secrets.env). The values come from the build
# variables of the same names (Settings → Builds → Variables and secrets), which override these empty ones.
# Never put real values here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEADS_SHEET_URL=
LEADS_SHEET_KEY=
